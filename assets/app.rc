#include <windows.h>

1 ICON "typecount.ico"
1 24 "TypeCount.manifest"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "TypeCount"
      VALUE "FileDescription", "TypeCount · Keyboard & Mouse Statistics"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "InternalName", "TypeCount"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "TypeCount.exe"
      VALUE "ProductName", "TypeCount"
      VALUE "ProductVersion", "1.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
